# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env

# Raw scientific data can be large; do not commit it to GitHub.
data/raw/*
!data/raw/**/.gitkeep

# Generated outputs; share the ZIP from downloads/ when needed.
data/processed/*
!data/processed/.gitkeep
downloads/*
!downloads/.gitkeep
logs/*
!logs/.gitkeep

# Earthdata URL lists may contain private download links.
download_urls.txt
